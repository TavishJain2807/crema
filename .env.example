# Copy to .env when using docker compose, or export these in your shell.
# The owner account gets the account-approval and backup controls in Settings.
CREMA_ADMIN_EMAIL=you@example.com

# Printed at the bottom of exported PDF journals.
CREMA_PDF_FOOTER=Made at home · Crema

# Where the SQLite database, photos, and nightly backups live
# (inside the container this is /data).
# COFFEE_DATA_DIR=./data

# Nightly backups: set CREMA_BACKUP=0 to turn the scheduler off.
# CREMA_BACKUP=1
# CREMA_BACKUP_HOURS=24
# CREMA_BACKUP_KEEP=14
